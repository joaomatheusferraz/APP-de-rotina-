<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Rotina.Mobile.App">
  <Application.Resources>
    <ResourceDictionary>
      <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F4F5FC, Dark=#090E1C}" />
      </Style>
      <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#18213B, Dark=#F3F5FF}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
      </Style>
      <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#18213B, Dark=#F3F5FF}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#59647E, Dark=#A5B1CC}" />
        <Setter Property="MinimumHeightRequest" Value="52" />
      </Style>
      <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#18213B, Dark=#F3F5FF}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light=#59647E, Dark=#A5B1CC}" />
        <Setter Property="MinimumHeightRequest" Value="52" />
      </Style>
      <Style TargetType="Button" x:Key="BaseButton">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EAECFA, Dark=#1C2942}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#384377, Dark=#E0E6FF}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light=#D0D8EF, Dark=#354465}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="FontAttributes" Value="Bold" />
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
      <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="#7664E8" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderColor" Value="#A79AF6" />
      </Style>
      <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light=#F4F5FC, Dark=#090E1C}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light=#18213B, Dark=#F3F5FF}" />
      </Style>
      <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="#38C9DE" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DEE3F3, Dark=#293651}" />
      </Style>
      <Style TargetType="Switch">
        <Setter Property="OnColor" Value="#7664E8" />
        <Setter Property="ThumbColor" Value="#C2B9FF" />
      </Style>
      <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#121C30}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#DEE3F3, Dark=#293651}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Padding" Value="20" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
